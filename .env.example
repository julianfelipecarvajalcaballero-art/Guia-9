# Puesto de Chance API — ejemplo de variables de entorno
# ---------------------------------------------------------------
# Cómo se cargan: la API usa dotenv (src/config/index.js ejecuta
# require('dotenv').config()). Copie este archivo como `.env` en la raíz
# del proyecto y ajuste los valores:
#
#     Windows PowerShell:  Copy-Item .env.example .env
#     Linux/macOS:         cp .env.example .env
#
# NINGUNA variable es obligatoria: cada una tiene un valor por omisión en
# src/config/index.js. Si no existe el archivo .env, la API arranca con
# los valores por defecto documentados a la derecha de cada variable.
# No suba el archivo .env real al repositorio: está excluido por .gitignore.

# Entorno de ejecución. La aplicación solo lo consulta para decidir si
# activa el registro de peticiones HTTP de morgan (lo omite en "test").
# Valores típicos: development | test | production
NODE_ENV=development

# Puerto HTTP donde escucha el servidor (por defecto 3000).
PORT=3000

# ---------------------------------------------------------------
# Seguridad de los tokens JWT
# ---------------------------------------------------------------
# Clave con la que se firman y verifican los tokens. OBLIGATORIA en
# producción con un valor largo y aleatorio; si se omite, la API usa el
# valor inseguro 'cambiar-este-secreto' (adecuado solo para desarrollo).
# Genere uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ponga-aqui-un-secreto-largo-y-aleatorio
# Vigencia del token de sesión (por defecto '8h'). Acepta formatos de
# ms de jsonwebtoken: '30m', '12h', '7d', etc.
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------
# Reglas del negocio (valores por defecto entre paréntesis)
# ---------------------------------------------------------------
# Zona horaria usada para agrupar ventas y cierres por fecha.
ZONA_HORARIA=America/Bogota
# Minutos tras la venta en los que se puede anular un tiquete (10).
MINUTOS_ANULACION=10
# Minutos antes de la fecha del sorteo en los que se cierran las ventas (15).
MINUTOS_CIERRE_VENTAS=15
# Valor mínimo de una apuesta de chance, en pesos (500).
APUESTA_MIN_CHANCE=500
# Valor máximo de una apuesta de chance, en pesos (50000).
APUESTA_MAX_CHANCE=50000
# Precio de cada jugada de Baloto, en pesos (5700).
VALOR_BALOTO=5700
# Días después de jugado el sorteo en los que caduca el premio (365).
DIAS_CADUCIDAD_PREMIO=365
